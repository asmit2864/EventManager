                                <rect key="frame" x="29" y="452" width="335" height="166"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                <string key="text">The idea for Event Manager was born from a common problem — planning events felt harder than it needed to be. From juggling guest lists to remembering deadlines, we realized there was no simple tool that brought everything together in one place.</string>
                                <color key="textColor" systemColor="labelColor"/>
