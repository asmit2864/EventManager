                            <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" fixedFrame="YES" text="Welcome to Event Manager – your smart solution for managing your events!" textAlignment="justified" translatesAutoresizingMaskIntoConstraints="NO" id="kZ9-Yn-Par">
                                <rect key="frame" x="29" y="187" width="335" height="59"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
